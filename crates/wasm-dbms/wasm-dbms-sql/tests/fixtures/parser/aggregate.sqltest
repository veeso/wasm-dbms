# Aggregate functions, GROUP BY, and HAVING.
#
# Format: see src/parser/tests/fixtures.rs.

=== count star
SELECT COUNT(*) FROM users
---
(select (columns (count *)) (from users))

=== count column
SELECT COUNT(email) FROM users
---
(select (columns (count email)) (from users))

=== every aggregate function
SELECT COUNT(*), SUM(price), AVG(price), MIN(price), MAX(price) FROM sales
---
(select (columns (count *) (sum price) (avg price) (min price) (max price)) (from sales))

=== function names are case insensitive
SELECT count(*), Sum(price), aVg(price) FROM sales
---
(select (columns (count *) (sum price) (avg price)) (from sales))

=== aggregate aliases
SELECT COUNT(*) AS total, SUM(price) AS revenue FROM sales
---
(select (columns (as (count *) total) (as (sum price) revenue)) (from sales))

=== group by
SELECT category, COUNT(*) FROM sales GROUP BY category
---
(select (columns category (count *)) (from sales) (group-by category))

=== group by several columns
SELECT category, region, SUM(price) FROM sales GROUP BY category, region
---
(select (columns category region (sum price)) (from sales) (group-by category region))

=== group by a qualified column
SELECT sales.category FROM sales GROUP BY sales.category
---
(select (columns sales.category) (from sales) (group-by sales.category))

=== having with an aggregate
SELECT category, COUNT(*) FROM sales GROUP BY category HAVING COUNT(*) > 5
---
(select (columns category (count *)) (from sales) (group-by category)
  (having (> (count *) 5)))

=== having with a compound condition
SELECT category FROM sales GROUP BY category HAVING SUM(price) >= 100 AND (MIN(price) > 1 OR category != 'misc')
---
(select (columns category) (from sales) (group-by category)
  (having (and (>= (sum price) 100) (or (> (min price) 1) (!= category 'misc')))))

=== having with in and is null
SELECT category FROM sales GROUP BY category HAVING COUNT(bonus) IN (1, 2) OR MAX(bonus) IS NULL
---
(select (columns category) (from sales) (group-by category)
  (having (or (in (count bonus) 1 2) (is-null (max bonus)))))

=== having without group by
SELECT COUNT(*) FROM sales HAVING COUNT(*) > 0
---
(select (columns (count *)) (from sales) (having (> (count *) 0)))

=== order by an aggregate
SELECT category, SUM(price) FROM sales GROUP BY category ORDER BY SUM(price) DESC, category
---
(select (columns category (sum price)) (from sales) (group-by category)
  (order-by ((sum price) desc) (category asc)))

=== order by an alias
SELECT category, COUNT(*) AS n FROM sales GROUP BY category ORDER BY n DESC LIMIT 3
---
(select (columns category (as (count *) n)) (from sales) (group-by category)
  (order-by (n desc)) (limit 3))

=== every clause of an aggregate query
SELECT category, COUNT(*) AS n, AVG(price) AS mean
FROM sales
WHERE price > 0
GROUP BY category
HAVING COUNT(*) >= ?
ORDER BY mean DESC
LIMIT 10 OFFSET ?
---
(select (columns category (as (count *) n) (as (avg price) mean)) (from sales)
  (where (> price 0)) (group-by category) (having (>= (count *) ?0))
  (order-by (mean desc)) (limit 10) (offset ?1))

=== qualified column inside an aggregate
SELECT SUM(sales.price) FROM sales
---
(select (columns (sum sales.price)) (from sales))

=== whitespace between the function name and the parenthesis
SELECT COUNT (*) FROM sales
---
(select (columns (count *)) (from sales))

=== error: sum star
SELECT SUM(*) FROM sales
---
error 1:12: expected a column name, found `*`

=== error: count distinct
SELECT COUNT(DISTINCT category) FROM sales
---
error 1:14: `DISTINCT` inside an aggregate function is not supported

=== error: aggregate without an argument
SELECT COUNT() FROM sales
---
error 1:14: expected a column name, found `)`

=== error: aggregate with two arguments
SELECT SUM(price, bonus) FROM sales
---
error 1:17: expected `)`, found `,`

=== error: nested aggregate
SELECT SUM(COUNT(*)) FROM sales
---
error 1:17: expected `)`, found `(`

=== error: unknown function
SELECT MEDIAN(price) FROM sales
---
error 1:8: unknown function `MEDIAN`; only COUNT, SUM, AVG, MIN and MAX are supported

=== error: aggregate of a literal
SELECT SUM(1) FROM sales
---
error 1:12: expected a column name, found number `1`

=== error: group without by
SELECT category FROM sales GROUP category
---
error 1:34: expected `BY`, found identifier `category`

=== error: group by an aggregate
SELECT category FROM sales GROUP BY COUNT(*)
---
error 1:42: expected end of statement, found `(`

=== error: group by position
SELECT category FROM sales GROUP BY 1
---
error 1:37: expected a column name, found number `1`

=== error: having before group by
SELECT category FROM sales HAVING COUNT(*) > 1 GROUP BY category
---
error 1:48: expected end of statement, found keyword `GROUP`

=== error: aggregate compared with an aggregate
SELECT category FROM sales GROUP BY category HAVING SUM(price) > SUM(bonus)
---
error 1:66: expected a literal or `?`, found identifier `SUM`

=== error: unclosed aggregate
SELECT COUNT(* FROM sales
---
error 1:16: expected `)`, found keyword `FROM`
